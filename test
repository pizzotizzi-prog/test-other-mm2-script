-- LOGICA DI CAMBIO SKIN (IL MOTORE)
local function ApplySkin(skinName)
    local data = SkinData[skinName]
    if not data then 
        print("Skin non trovata nel database!") 
        return 
    end

    local char = game.Players.LocalPlayer.Character
    if not char then return end

    -- Cerca l'arma equipaggiata
    local weapon = char:FindFirstChildOfClass("Tool") or char:FindFirstChild("Knife") or char:FindFirstChild("Gun")
    if not weapon then
        print("Equippa prima l'arma!")
        return
    end

    local handle = weapon:FindFirstChild("Handle")
    if not handle then return end

    -- Pulizia vecchia skin
    for _, v in pairs(handle:GetChildren()) do
        if v:IsA("SpecialMesh") or v:IsA("MeshPart") or v:IsA("Decal") then
            v:Destroy()
        end
    end

    -- Applicazione nuova skin (Semplificata per compatibilità Xeno)
    local modelData = data.Model
    if modelData.Class == "MeshPart" then
        local mesh = Instance.new("SpecialMesh", handle)
        mesh.MeshId = modelData.Props.MeshId or ""
        mesh.TextureId = modelData.Props.TextureID or ""
        handle.Color = modelData.Props.Color or Color3.new(1,1,1)
    elseif modelData.Class == "Part" then
        handle.Color = modelData.Props.Color or Color3.new(1,1,1)
    end
    
    print("Skin " .. skinName .. " applicata con successo!")
end

